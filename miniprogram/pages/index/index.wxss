/* pages/index/index.wxss */
.container {
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.header {
  width: 100%;
  text-align: center;
  margin-bottom: 30rpx;
}

.title {
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
}

.image-container {
  width: 100%;
  margin-bottom: 30rpx;
  border: 2rpx solid #ddd;
  border-radius: 16rpx;
  overflow: hidden;
}

.preview-image {
  width: 100%;
}

.button-group {
  width: 100%;
  display: flex;
  justify-content: space-around;
  margin-bottom: 30rpx;
}

.btn {
  width: 45%;
  margin: 0;
}

.result-container {
  width: 100%;
  padding: 20rpx;
  background-color: #f5f5f5;
  border-radius: 16rpx;
  margin-top: 20rpx;
}

.result-title {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
  display: block;
}

.result-item {
  padding: 10rpx 0;
  border-bottom: 1rpx solid #ddd;
  font-size: 28rpx;
}

.count {
  display: block;
  margin-top: 20rpx;
  font-size: 32rpx;
  color: #07c160;
  font-weight: bold;
}

/* 新增：算式批改结果样式 */
.questions-container {
  width: 100%;
  margin-top: 30rpx;
  padding: 20rpx;
  background-color: #f0f8ff;
  border-radius: 16rpx;
  border-left: 8rpx solid #07c160;
}

.questions-title {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
  display: block;
  color: #333;
}

.question-item {
  padding: 20rpx;
  border-bottom: 1rpx solid #e0e0e0;
  font-size: 32rpx;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  background-color: white;
  margin-bottom: 10rpx;
  border-radius: 12rpx;
}

.question-item:last-child {
  border-bottom: none;
}

.question-text {
  font-weight: 500;
  min-width: 200rpx;
}

.correct {
  color: #07c160;
  font-weight: bold;
  margin-left: 20rpx;
  font-size: 40rpx;
}

.wrong {
  color: #e64340;
  font-weight: bold;
  margin-left: 20rpx;
  font-size: 40rpx;
}

.correct-answer {
  color: #ff9900;
  margin-left: 20rpx;
  font-size: 28rpx;
  background-color: #fff3e0;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
}

.statistics {
  margin-top: 30rpx;
  padding: 20rpx;
  background-color: #e8f5e9;
  border-radius: 12rpx;
  text-align: center;
}

.stat-text {
  font-size: 32rpx;
  color: #2e7d32;
  font-weight: bold;
}

.empty-container {
  width: 100%;
  padding: 60rpx 20rpx;
  background-color: #fafafa;
  border-radius: 16rpx;
  margin-top: 30rpx;
  text-align: center;
}

.empty-text {
  font-size: 32rpx;
  color: #999;
}

/* 新增：隐藏 canvas 样式 */
.hidden-canvas {
  position: fixed;
  top: -9999rpx;
  left: -9999rpx;
  width: 375px;
  height: 600px;
  opacity: 0;
  pointer-events: none;
}